# Variables de entorno necesarias para desplegar INKASANA-BACKEND
#
# Este proyecto es independiente de la plataforma: corre en cualquier lugar
# que soporte Docker (Render, Railway, Fly.io, AWS, DigitalOcean App Platform, etc.)
# usando el Dockerfile de la raíz del proyecto.
#
# Copia este archivo, rellena los valores reales y pégalos en el panel de
# "Environment Variables" de la plataforma elegida. NUNCA subas los valores
# reales a git — solo esta plantilla con placeholders.
# --- Base de datos (Neon Postgres, ya está en la nube) ---
DB_SERVER=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# --- Auth0 (autenticación de usuarios) ---
AUTH0_DOMAIN=
AUTH0_MANAGEMENT_DOMAIN=
# --- Mercado Pago (pagos y suscripciones) ---
# TEST-... para sandbox/testing. APP_USR-... para producción real.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=PEN
# --- JWT interno de la aplicación ---
APP_JWT_SECRET=
APP_JWT_EXPIRATION_SECONDS=3600
# --- URLs públicas (cambian según dónde se despliegue el frontend) ---
# URL pública del frontend (Vercel, Netlify, o el dominio final).
# Se usa como back_url para Mercado Pago y como base de los links de la app.
FRONTEND_URL=
# Orígenes permitidos para CORS. Debe incluir la misma URL de FRONTEND_URL.
# Se pueden poner varias separadas por coma:
# https://mi-app.vercel.app,https://otro-dominio.com
ALLOWED_ORIGINS=
# --- Puerto (algunas plataformas como Render lo inyectan automáticamente) ---
PORT=8080
# Mantener en false en producción para no exponer consultas SQL en los logs.
SHOW_SQL=false
# ============================================================
# Checklist adicional para quien despliegue (no son env vars):
#
# 1. En el panel de Mercado Pago Developers -> tu App -> Webhooks,
#    configurar la Notification URL apuntando a:
#    <FRONTEND_URL o dominio del backend>/api/billing/webhook/mercadopago
#
# 2. En el dashboard de Auth0 -> tu Application -> Settings, agregar
#    la URL final del frontend a:
#    - Allowed Callback URLs
#    - Allowed Logout URLs
#    - Allowed Web Origins
#
# 3. El Dockerfile en la raíz del proyecto ya está listo para build.
#    No requiere configuración adicional, solo las variables de arriba.
# ============================================================